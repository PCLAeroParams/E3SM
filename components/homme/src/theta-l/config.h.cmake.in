/* PRIM Options */

/* Energy Diagnostics */
#cmakedefine ENERGY_DIAGNOSTICS

/* Lorenz model */
#define MODEL_THETA_L

/* Using PRIMITIVE */
#define _PRIM

/* WK_GRAD */
#define _WK_GRAD 1

/* _PRESTART */
#define _PRESTART 1

/* Using MPI */
#define _MPI 1

/* PIO with interpolation */
#cmakedefine PIO_INTERP

/* Number of cells NC*NC in each element (Default value NC=4) */
#define NC @NUM_CELLS@

/* Number of POINTS in the element (Default value is 4) */
#define NP @NUM_POINTS@

/* Number of POINTS in the element (Default value is 1) */
#define PLEV @NUM_PLEV@

/* Number of tracers (Default value 4 if not specified) */
#cmakedefine QSIZE_D @QSIZE_D@

/* Basic PIO */
#cmakedefine PIO

/* Whether to use CUDA Fortran */
#cmakedefine01 USE_CUDA_FORTRAN

/* Whether to use OPENACC */
#cmakedefine01 USE_OPENACC

/* Quadruple-precision */
#cmakedefine01 HOMME_QUAD_PREC

/* Horizontal OpenMP (over elements) */
#cmakedefine HORIZ_OPENMP

/* Vertical OpenMP (within elements) */
#cmakedefine COLUMN_OPENMP

/* Nested OpenMP (both horizontal and vertical) */
#cmakedefine NESTED_OPENMP

/* Zoltan partitioning library */
#cmakedefine01 HAVE_ZOLTAN

/* Using Accelerator */
#cmakedefine IS_ACCELERATOR

/* Whether to use OpenMP4 */
#cmakedefine OMP4

/* Whether this is a build for CUDA/HIP (used for f90-vs-cxx bfb math functions */
/* impl). This symbol is visible in the F90 code, unlike HOMMEXX_ENABLE_GPU */
/* defined in Hommexx_config.h. */
#cmakedefine HOMMEXX_ENABLE_GPU_F90

/* temporary flag to compare f90-cxx until we settle on either cxx or f90 implementation */
#cmakedefine XX_NONBFB_COMING

/* When doing BFB testing, we occasionally must modify bits. Use this flag to protect such code. */
#cmakedefine HOMMEXX_BFB_TESTING

/* Detect whether this is a kokkos target */
#cmakedefine01 KOKKOS_TARGET

/* Detect whether COMPOSE passive tracer transport is enabled */
#cmakedefine HOMME_ENABLE_COMPOSE

/* Detect whether PartMC stochastic transport is enabled */
#cmakedefine HOMME_ENABLE_PARTMCSL

/* Enable Test S SBR wind override + Q7 analytic-exact diagnostic (off by default) */
#cmakedefine PARTMCSL_SBR_DIAG

/* Skip dcmip2012_test1_1_phys_to_dyn A/B-only build guard (off by default) */
#cmakedefine PARTMCSL_SKIP_PHYS_TO_DYN

/* Skip partmcsl runtime transport calls in prim_step A/B-only build guard */
#cmakedefine PARTMCSL_SKIP_STEP_FORWARD

/* Skip prim_init1_partmcsl A/B-only build guard */
#cmakedefine PARTMCSL_SKIP_INIT

/* Skip dcmip12_wrapper HOMME_ENABLE_PARTMCSL init block A/B-only build guard */
#cmakedefine PARTMCSL_SKIP_WRAPPER_INIT

/* Perturb the tracer mirror by a factor of 0.99999 instead of exact copy. A/B for CEDR robustness to bit-duplicate tracers. */
#cmakedefine PARTMCSL_PERTURB_MIRROR

/* Overwrite q slots 5 to 8 with spatial constants at t=0 instead of mirroring q 1 to 4. A/B to distinguish qsize count from duplicate content as fragmentation trigger. */
#cmakedefine PARTMCSL_CONST_MIRROR

/* Print tracer mass sums on FV pg_data q and GLL state Q at every output snapshot. Diagnostic for isolating whether mass loss is in PartMCSL or in the FV to GLL projection. */
#cmakedefine PARTMCSL_DIAG_MASS